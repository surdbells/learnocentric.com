# --- App ---
APP_ENV=dev
APP_DEBUG=true
APP_URL=http://127.0.0.1:8090

# CORS: comma-separated allowed origins for the SPA
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Table-driven RBAC enforcement. Off by default: role_permissions are advisory
# until this is enabled. Turn on (true) ONLY after verifying the seeded permission
# matrix in staging — otherwise tagged routes may 403 legitimate users.
RBAC_ENFORCE=false

# --- Database (PostgreSQL) ---
# Host port 5433 maps to the container's 5432 (see docker-compose.yml).
DB_DRIVER=pdo_pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=learnocentric
DB_USER=learno
DB_PASSWORD=learno_secret

# --- Auth ---
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_TTL=86400
JWT_ISSUER=learnocentric

# --- ZeptoMail (email delivery) ---
# https://www.zoho.com/zeptomail/
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_TOKEN=
MAIL_FROM_ADDRESS=noreply@learnocentric.com
MAIL_FROM_NAME=LearnoCentric

# --- Daily.co (live video classes) ---
# https://docs.daily.co/reference/rest-api
DAILY_API_URL=https://api.daily.co/v1
DAILY_API_KEY=

# --- File storage (Flysystem) ---
# driver: local (default) | s3 (future)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=public/uploads
STORAGE_PUBLIC_URL=http://127.0.0.1:8090/uploads

# --- Paystack (billing) ---
# https://paystack.com/docs/api/
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:4200/billing/callback
