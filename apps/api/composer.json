{
  "name": "learnocentric/api",
  "description": "LearnoCentric LMS API — PHP Slim 4 + Doctrine ORM + PostgreSQL.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "php-di/php-di": "^7.0",
    "doctrine/orm": "^3.3",
    "doctrine/dbal": "^4.2",
    "doctrine/migrations": "^3.8",
    "symfony/cache": "^7.1",
    "vlucas/phpdotenv": "^5.6",
    "ramsey/uuid": "^4.7",
    "monolog/monolog": "^3.7",
    "guzzlehttp/guzzle": "^7.9",
    "league/flysystem": "^3.29"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "App\\Migrations\\": "migrations/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-di/php-di": true
    },
    "platform": {
      "ext-redis": false
    }
  },
  "scripts": {
    "migrate": "php bin/console.php migrations:migrate --no-interaction",
    "diff": "php bin/console.php migrations:diff",
    "seed": "php bin/console.php app:seed"
  }
}
