{
  "name": "learnocentric-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "LearnoCentric LMS monorepo — Angular frontend (apps/web) + PHP Slim API (apps/api).",
  "scripts": {
    "start": "npm --prefix apps/web run start",
    "web": "npm --prefix apps/web run start",
    "web:install": "npm --prefix apps/web install",
    "web:build": "npm --prefix apps/web run build",
    "api:serve": "php -S 127.0.0.1:8090 -t apps/api/public",
    "api:install": "composer --working-dir=apps/api install",
    "api:migrate": "php apps/api/bin/console.php migrations:migrate --no-interaction",
    "api:seed": "php apps/api/bin/console.php app:seed",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  }
}
